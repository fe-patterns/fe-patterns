---
// The fe-patterns mark. Path + viewBox come from the shared brand module so the
// mark is defined once (see src/lib/brand.ts). Uses currentColor so it follows
// the surrounding text colour (light/dark). Height is controlled via CSS.
import { LOGO_PATH, LOGO_VIEWBOX } from "../lib/brand";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox={`0 0 ${LOGO_VIEWBOX.w} ${LOGO_VIEWBOX.h}`}
  fill="none"
  role="img"
  aria-label="fe-patterns"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d={LOGO_PATH} fill="currentColor" fill-rule="evenodd"></path>
</svg>
