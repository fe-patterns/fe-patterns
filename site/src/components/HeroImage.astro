---
// In-page hero band for blog posts. Takes a `hero` filename from the post's
// frontmatter, resolves it against src/assets/hero/ (so Astro optimises it), and
// renders it as a full-width, 1.91:1 cover-cropped banner — the same aspect as
// the OG card, so the page and the share preview show the same framing.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;

// PNG/JPEG/WebP only — these decode in both Astro's optimiser and the OG
// renderer's CanvasKit (which can't decode AVIF).
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hero/*.{png,jpg,jpeg,webp}",
);
const loader = images[`../assets/hero/${src}`];
if (!loader) {
  throw new Error(
    `Hero image not found: src/assets/hero/${src}. Available: ${Object.keys(images).join(", ")}`,
  );
}
const { default: image } = await loader();
---

<figure class="post-hero">
  <Image src={image} alt={alt} widths={[600, 900, 1200]} sizes="(min-width: 44rem) 44rem, 100vw" />
</figure>

<style>
  .post-hero {
    margin: 0 0 2rem;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .post-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
