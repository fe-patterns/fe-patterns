---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import HeroImage from "../../../components/HeroImage.astro";
import Newsletter from "../../../components/Newsletter.astro";
import { formatDate, postSlug } from "../../../lib/blog";
import { AUTHOR } from "../../../lib/brand";
import avatar from "../../../assets/avatar.jpg";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { id: postSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const title = entry.data.title ?? entry.id;
const explores = entry.data.explores ?? [];
const hero = entry.data.hero;
---

<Base
  title={title}
  description={entry.data.description}
  image={`/og/blog/${entry.id}.png`}
>
  <article class="prose">
    {hero && <HeroImage src={hero} alt={title} />}
    <h1>{title}</h1>
    <div class="post-byline">
      <Image class="byline-avatar" src={avatar} alt="" width={96} height={96} />
      <div class="byline-text">
        <a href="/about#author">{AUTHOR}</a>
        {entry.data.date && <div class="byline-date">{formatDate(entry.data.date)}</div>}
      </div>
    </div>
    <Content />
    {
      explores.length > 0 && (
        <footer class="post-explores">
          <span>Explores</span>
          {explores.map((slug, i) => (
            <Fragment>
              {i > 0 ? ", " : ""}
              <a href={`/patterns/${slug}`}>{slug}</a>
            </Fragment>
          ))}
        </footer>
      )
    }
  </article>
  <Newsletter />
</Base>
