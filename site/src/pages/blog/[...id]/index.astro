---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import HeroImage from "../../../components/HeroImage.astro";
import Newsletter from "../../../components/Newsletter.astro";
import Outline from "../../../components/Outline.astro";
import { postSlug } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { id: postSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const title = entry.data.title ?? entry.id;
const explores = entry.data.explores ?? [];
const hero = entry.data.hero;
const fmt = (d?: Date) =>
  d ? d.toISOString().slice(0, 10).replace(/-/g, ".") : "";
---

<Base
  title={title}
  description={entry.data.description}
  image={`/og/blog/${entry.id}.png`}
>
  <Outline headings={headings} />
  <article class="prose">
    {hero && <HeroImage src={hero} alt={title} />}
    <h1>{title}</h1>
    {entry.data.date && <p class="post-meta">{fmt(entry.data.date)}</p>}
    <Content />
    {
      explores.length > 0 && (
        <footer class="post-explores">
          <span>Explores</span>
          {explores.map((slug, i) => (
            <Fragment>
              {i > 0 ? ", " : ""}
              <a href={`/patterns/${slug}`}>{slug}</a>
            </Fragment>
          ))}
        </footer>
      )
    }
  </article>
  <Newsletter />
</Base>
