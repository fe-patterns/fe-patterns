---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, postHref } from "../../lib/blog";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<Base title="Blog" description="Posts exploring frontend patterns.">
  <h1>Blog</h1>
  {
    posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => (
          <li>
            <a href={postHref(post)}>{post.data.title ?? post.id}</a>
            <div class="meta">{formatDate(post.data.date)}</div>
          </li>
        ))}
      </ul>
    )
  }
</Base>
